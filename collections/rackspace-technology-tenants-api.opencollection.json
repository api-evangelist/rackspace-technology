{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rackspace Cloud DNS Contacts Tenants API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tenants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Tenants",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dns.api.rackspacecloud.com/v1.0/v2.0/tenants"
          },
          "docs": "Lists all tenants accessible to the caller."
        },
        {
          "info": {
            "name": "Get Tenant By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dns.api.rackspacecloud.com/v1.0/v2.0/tenants/:tenantId",
            "params": [
              {
                "name": "tenantId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Tenant By Id"
        }
      ]
    }
  ],
  "bundled": true
}